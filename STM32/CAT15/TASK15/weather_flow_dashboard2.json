    "name": "Extract Sensor Readings",
    "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) { return null; }\n}\nif (!data) return null;\n\nvar t = parseFloat(data.temperature !== undefined ? data.temperature : 0);\nvar p = parseFloat(data.pressure !== undefined ? data.pressure : 0);\nvar h = parseFloat(data.humidity !== undefined ? data.humidity : 0);\n\nvar msgT = { payload: Number(t.toFixed(2)), topic: 'Sensor Temperature' };\nvar msgP = { payload: Number(p.toFixed(2)), topic: 'Sensor Pressure' };\nvar msgH = { payload: Number(h.toFixed(2)), topic: 'Sensor Humidity' };\n\nreturn [msgT, msgP, msgH];",
