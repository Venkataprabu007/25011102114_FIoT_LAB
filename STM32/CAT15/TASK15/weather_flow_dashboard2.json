  {
    "id": "func_cricket_insights",
    "type": "function",
    "z": "tab_bme280_owm_d2",
    "name": "Cricket Conditions & Insights",
    "func": "// Keep the latest college sensor and Chennai API readings for live comparison.\nvar d=msg.payload;\nif (typeof d === 'string') { try { d=JSON.parse(d); } catch(e) { return null; } }\nif (!d || typeof d !== 'object') return null;\nvar s=flow.get('cricket_sensor') || {};\nvar a=flow.get('cricket_api') || {};\nif (d.main && d.main.temp !== undefined) {\n    a={t:Number(d.main.temp), h:Number(d.main.humidity), p:Number(d.main.pressure)};\n    flow.set('cricket_api',a);\n} else if (d.temperature !== undefined) {\n    s={t:Number(d.temperature), h:Number(d.humidity), p:Number(d.pressure)};\n    flow.set('cricket_sensor',s);\n} else { return null; }\nif (!Number.isFinite(s.t) || !Number.isFinite(a.t)) return null;\nvar t=s.t;\nvar decision, band;\nif (t > 26) {\n    decision='NO — HOT: '+t.toFixed(1)+' °C is above 26 °C. Choose a cooler time under this project rule.';\n    band='HOT (>26 °C) — red zone.';\n} else if (t < 18) {\n    decision='NO — COLD: '+t.toFixed(1)+' °C is below 18 °C. Warm up and reassess before play.';\n    band='COLD (<18 °C) — blue zone.';\n} else {\n    decision='YES — PLAYABLE: '+t.toFixed(1)+' °C is within the normal 18–26 °C range.';\n    band='NORMAL (18–26 °C) — green zone.';\n}\nvar drizzle;\nif (s.h > 65) drizzle='POSSIBLE DRIZZLE: campus humidity is '+s.h.toFixed(1)+'% (above 65%). Check the ground and local weather before play; humidity alone cannot confirm rain.';\nelse drizzle='No humidity-based drizzle alert: campus humidity is '+s.h.toFixed(1)+'% (65% or lower). Still check the ground before play.';\nvar cool;\nif (s.t < 24) cool='COOL-WEATHER ALERT: campus temperature is '+s.t.toFixed(1)+' °C, below 24 °C. It may feel cool; allow time for a warm-up before play.';\nelse cool='No below-24 °C cool-weather alert: campus temperature is '+s.t.toFixed(1)+' °C.';\nvar comparison='Campus vs Chennai: temperature difference '+Math.abs(s.t-a.t).toFixed(1)+' °C.';\ncomparison+=' The match decision uses the college sensor; the API is a city reference.';\nfunction card(text){ return '<div style=\"white-space:normal;overflow-wrap:anywhere;line-height:1.5;font-weight:500\">'+text+'</div>'; }\nreturn [\n {payload:card(decision),topic:'Cricket match decision'},\n {payload:card(band),topic:'Temperature band'},\n {payload:card(comparison),topic:'Campus/API comparison'},\n {payload:card(drizzle),topic:'Humidity/drizzle advisory'},\n {payload:card(cool),topic:'Cool-weather alert'}\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 900,
    "wires": [
      [
